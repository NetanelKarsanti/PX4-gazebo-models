<?xml version="1.0" encoding="UTF-8"?>

<sdf version="1.9">

  <world name="demo_field">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin
      filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <plugin
      filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>
    <plugin
      filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>

    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 1.0 1</background>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <include>
      <uri>model://field_floor</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ============================================================
         Crop rows: 5 parallel green boxes along X axis
         Each: 10m (X) x 0.5m (Y) x 0.4m (Z)
         Y centers: -7.5, -4.5, -1.5, +1.5, +4.5
         Corridors at Y = -6, -3, 0, +3 (each 2.5m wide)
         ============================================================ -->

    <model name="row_1">
      <static>true</static>
      <pose>0 -7.5 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
          <material>
            <ambient>0.05 0.30 0.05 1</ambient>
            <diffuse>0.10 0.60 0.10 1</diffuse>
            <specular>0.05 0.10 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="row_2">
      <static>true</static>
      <pose>0 -4.5 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
          <material>
            <ambient>0.05 0.30 0.05 1</ambient>
            <diffuse>0.10 0.60 0.10 1</diffuse>
            <specular>0.05 0.10 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="row_3">
      <static>true</static>
      <pose>0 -1.5 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
          <material>
            <ambient>0.05 0.30 0.05 1</ambient>
            <diffuse>0.10 0.60 0.10 1</diffuse>
            <specular>0.05 0.10 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="row_4">
      <static>true</static>
      <pose>0 1.5 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
          <material>
            <ambient>0.05 0.30 0.05 1</ambient>
            <diffuse>0.10 0.60 0.10 1</diffuse>
            <specular>0.05 0.10 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="row_5">
      <static>true</static>
      <pose>0 4.5 0.2 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
          <material>
            <ambient>0.05 0.30 0.05 1</ambient>
            <diffuse>0.10 0.60 0.10 1</diffuse>
            <specular>0.05 0.10 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>10 0.5 0.4</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- ============================================================
         Obstacles - all red, all inside corridors only
         Heights: 0.3 / 0.6 / 1.0 / 1.5 m
         Only ONE obstacle (obs_full_block) spans the full 2.5m corridor width
         All others are 1.0m wide - drone may hop or bypass laterally
         Max 2 obstacles per corridor
         ============================================================ -->

    <!-- Corridor Y = -6 (south) : 1 obstacle -->
    <model name="obs_south_med">
      <static>true</static>
      <pose>-2 -6 0.30 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 1.0 0.6</size></box></geometry>
          <material>
            <ambient>0.40 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
            <specular>0.20 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.6 1.0 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Corridor Y = -3 : 2 obstacles (low warmup + tall challenge) -->
    <model name="obs_c2_low">
      <static>true</static>
      <pose>-3 -3 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 1.0 0.3</size></box></geometry>
          <material>
            <ambient>0.40 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
            <specular>0.20 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.6 1.0 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="obs_c2_tall">
      <static>true</static>
      <pose>2 -3 0.75 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 1.0 1.5</size></box></geometry>
          <material>
            <ambient>0.40 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
            <specular>0.20 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.6 1.0 1.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Corridor Y = 0 (central) : 2 obstacles (low warmup + the ONE full blocker) -->
    <model name="obs_central_low">
      <static>true</static>
      <pose>-4 0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 1.0 0.3</size></box></geometry>
          <material>
            <ambient>0.40 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
            <specular>0.20 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.6 1.0 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

    <model name="obs_full_block">
      <static>true</static>
      <pose>0 0 0.50 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 2.5 1.0</size></box></geometry>
          <material>
            <ambient>0.40 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
            <specular>0.20 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.6 2.5 1.0</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Corridor Y = +3 (north) : 1 obstacle -->
    <model name="obs_north_med">
      <static>true</static>
      <pose>-2 3 0.30 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.6 1.0 0.6</size></box></geometry>
          <material>
            <ambient>0.40 0.05 0.05 1</ambient>
            <diffuse>0.85 0.10 0.10 1</diffuse>
            <specular>0.20 0.05 0.05 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry><box><size>0.6 1.0 0.6</size></box></geometry>
        </collision>
      </link>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>
