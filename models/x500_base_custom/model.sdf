<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='x500_base_custom'>

    <pose>0 0 .24 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    
    <link name="base_link">
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.02166666666666667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02166666666666667</iyy>
          <iyz>0</iyz>
          <izz>0.04000000000000001</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay />
      <!-- assembly STL visual-->
      <visual name="base_link_visual">
        <!-- edit here - stl position -->
        <pose> -0.3 0.3 -0.15 0 0 -1.570796327</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <!-- edit here - add model stl/dae file -->
            <uri>model://x500_base_custom/meshes/Holybro_X500_V4.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
        </material>
      </visual>
      <!-- motor visual-->
      <visual name="5010_motor_base_0">
        <pose>0.174 0.174 .032 0 0 -.45</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://x500_base_custom/meshes/5010Base.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <visual name="5010_motor_base_1">
        <pose>-0.174 0.174 .032 0 0 -.45</pose>
